# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser).
# Either variable name works; NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY takes priority.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional ---
# Set to "production" to enable Vercel Analytics in the client bundle.
NODE_ENV=development

# --- SEO (optional but recommended) ---
# Canonical production origin, used for metadataBase, canonical URLs,
# robots.txt and sitemap.xml. No trailing slash.
# e.g. https://duo-chaos.vercel.app
NEXT_PUBLIC_SITE_URL=
